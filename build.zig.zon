.{
    .name = .cljw,
    .version = "1.14.1",
    .fingerprint = 0x1869d207073beffa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zlinter = .{
            .url = "git+https://github.com/kurtwagner/zlinter?ref=0.16.x#9b4d67b9725e7137ac876cc628fe5dd2ca5a2681",
            .hash = "zlinter-0.0.1-OjQ08c7oCwDIwhlde7eDKMACNTsqAhGXy5vB7GdfGobG",
            // Development-only: build-lint.zig is configured only by
            // `zig build lint`; normal and release builds must stay offline.
            .lazy = true,
        },
        // zwasm v2 embedding API (F-001 / D-037). `lazy` so the DEFAULT build +
        // gate never resolve it — only `-Dwasm` (b.lazyDependency) does.
        //
        // PINNED to STABLE tag **v2.6.0** (2026-09-05, user direction: unpin
        // from v2.5.0, track the latest release). zwasm is maintained
        // separately at its own `zwasm` org since 2026-08-12; this pin moves on
        // this fork's schedule, on user direction (F-001 Revision history).
        //
        // One embedding-API change since v2.5.0: zwasm #257 widened the
        // captured-run stdin from `?[]const u8` to a `StdinSource` union
        // (adapted in `src/runtime/cljw/wasm/engine.zig`; `.inherit` is not
        // wired). v2.6.0 does NOT fix zwasm/D-584 / zwasm/D-585, the per-call
        // JIT cost measured in `.dev/wasm_percall_findings.md`.
        //
        // Bumping: `zig fetch` rejects the annotated TAG object (NotACommit);
        // peel it with `git rev-parse 'vX.Y.Z^{}'` to get the commit sha.
        //
        // Pin history: v2.5.0 (2026-08-12) full WASI 0.3 coverage + the 81
        // C-API symbols (#161); v2.4.1 (2026-08-04) two cljw-found fixes,
        // #157 (multi-export components) and #158/#159 (captured-run output
        // bound, D-349); v2.4.0 (2026-08-03) external-consumer release; v2.3.0
        // (2026-07-17) WASI-0.3.0 sweep; v2.2.1 (2026-07-16) binary-size
        // campaign; v2.2.0 (2026-07-09) AOT full fidelity. The embedding
        // surface (Engine/Module/Instance on `.auto`, D-488) is unchanged
        // since v2.2.0.
        //
        // The URL is the canonical `zwasm/zwasm` org; do NOT rely on GitHub's
        // transfer redirect from `clojurewasm/zwasm`, which stops being an
        // alias the moment anything else claims that name. The `.hash` is
        // content-addressed, so the org move did not change it.
        .zwasm = .{
            .url = "git+https://github.com/zwasm/zwasm.git?ref=v2.6.0#3831e68b9af2e59a54ebc623fc11d5d1c24fc974",
            .hash = "zwasm-2.6.0-FT1Fv3i-lgDA0y5x6L4L0V17CEoG6Bxg7p0_6kN6LUuy",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build-lint.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "legal",
        "CHANGELOG.md",
        "README.md",
    },
}
