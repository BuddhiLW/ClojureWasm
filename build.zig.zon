.{
    .name = .cljw,
    .version = "1.14.6",
    .fingerprint = 0x1869d207073beffa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zlinter = .{
            .url = "git+https://github.com/kurtwagner/zlinter?ref=0.16.x#9b4d67b9725e7137ac876cc628fe5dd2ca5a2681",
            .hash = "zlinter-0.0.1-OjQ08c7oCwDIwhlde7eDKMACNTsqAhGXy5vB7GdfGobG",
            // Development-only: build-lint.zig is configured only by
            // `zig build lint`; normal and release builds must stay offline.
            .lazy = true,
        },
        // zwasm v2 embedding API (F-001 / D-037). `lazy` so the DEFAULT build +
        // gate never resolve it — only `-Dwasm` (b.lazyDependency) does.
        //
        // PINNED to the `cljw` branch of THIS FORK, BuddhiLW/zwasm
        // (2026-09-14, user direction: "use our zwasm for now"). That branch
        // is upstream v2.7.0 (d09d9248) plus two fixes found from cljw that
        // upstream does not carry yet: every exported interface of a
        // component resolves (fix/instance-reexport, cljw card
        // ZWASM-INSTANCE-REEXPORT) and a rust-std wasip2 guest that touches
        // the filesystem links (fix/p2-metadata-hash-at: the 0.2
        // metadata-hash / metadata-hash-at rows plus the shifted 0.2
        // error-code ordinals, cljw card CLJW-WASIP2-STD). Both are on the
        // fork as PR-ready branches for github.com/zwasm/zwasm; when upstream
        // carries them the pin returns to a zwasm/zwasm tag.
        //
        // Previous pin: stable tag v2.6.0 (2026-09-05). The v2.6.0 -> v2.7.0
        // embedding-API delta is additive (five engine hooks,
        // `Instance.engine()`, two appended trap kinds); one behaviour change,
        // `.auto` no longer retries the interpreter on a JIT validity verdict.
        // The per-call JIT cost (zwasm/D-584 / D-585,
        // `.dev/wasm_percall_findings.md`) is still open.
        //
        // Bumping: `zig fetch` rejects the annotated TAG object (NotACommit);
        // peel it with `git rev-parse 'vX.Y.Z^{}'` to get the commit sha. A
        // branch pin names the commit the same way (`?ref=<branch>#<sha>`).
        //
        // Pin history: v2.6.0 (2026-09-05) StdinSource union (#257);
        // v2.5.0 (2026-08-12) full WASI 0.3 coverage + the 81
        // C-API symbols (#161); v2.4.1 (2026-08-04) two cljw-found fixes,
        // #157 (multi-export components) and #158/#159 (captured-run output
        // bound, D-349); v2.4.0 (2026-08-03) external-consumer release; v2.3.0
        // (2026-07-17) WASI-0.3.0 sweep; v2.2.1 (2026-07-16) binary-size
        // campaign; v2.2.0 (2026-07-09) AOT full fidelity. The embedding
        // surface (Engine/Module/Instance on `.auto`, D-488) is unchanged
        // since v2.2.0.
        //
        // Upstream is the `zwasm/zwasm` org; do NOT rely on GitHub's transfer
        // redirect from `clojurewasm/zwasm`, which stops being an alias the
        // moment anything else claims that name. The `.hash` is
        // content-addressed, so the host of the URL never changes it.
        .zwasm = .{
            .url = "git+https://github.com/BuddhiLW/zwasm.git?ref=cljw#544f9c12fa19fbe952144b64ebcabf781c14a497",
            .hash = "zwasm-2.7.0-FT1Fv_ZInADJZP5qmVfBJwpwDOJBdw4smLQ3wP5AVDBe",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build-lint.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "legal",
        "CHANGELOG.md",
        "README.md",
    },
}
