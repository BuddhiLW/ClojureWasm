.{
    .name = .cljw,
    .version = "1.7.0",
    .fingerprint = 0x1869d207073beffa,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zlinter = .{
            .url = "git+https://github.com/kurtwagner/zlinter?ref=0.16.x#9b4d67b9725e7137ac876cc628fe5dd2ca5a2681",
            .hash = "zlinter-0.0.1-OjQ08c7oCwDIwhlde7eDKMACNTsqAhGXy5vB7GdfGobG",
        },
        // zwasm v2 embedding API (F-001 / D-037). `lazy` so the DEFAULT build +
        // gate never resolve it — only `-Dwasm` (b.lazyDependency) does.
        // PINNED to STABLE tag **v2.4.0** (2026-08-03): the external-consumer
        // release — `-Dcompiler-rt` for linking libzwasm.a from a non-Zig
        // toolchain, plus a DCE fix keeping the WasmGC cohort out of sub-3.0
        // builds. NEITHER reaches cljw: cljw links zwasm through Zig
        // (`b.lazyDependency`), which supplies its own compiler-rt, and it
        // builds at zwasm's default `-Dwasm=3.0`, so the sub-3.0 DCE fix is
        // out of scope. This pin is hygiene — keeping the tag current, not
        // chasing a behaviour change. Prior v2.3.0 (2026-07-17) = WASI-0.3.0
        // inventory sweep; v2.2.1 (2026-07-16) = binary-size campaign (zwasm
        // ADR-0204 / D-522, CLI -21%); v2.2.0 (2026-07-09) = AOT full fidelity
        // (ADR-0203). cljw's embedding surface (Engine/Module/Instance via
        // `.auto` =JIT-default, D-488) is unchanged. lazy + flag-guard means a
        // churning dep cannot break the default gate.
        .zwasm = .{
            .url = "git+https://github.com/clojurewasm/zwasm.git#v2.4.0",
            .hash = "zwasm-2.4.0-FT1Fv9E0jQCqP2Pd8DiSEWZMwqmdl-uPzntoEnBxDlro",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "legal",
        "CHANGELOG.md",
        "README.md",
    },
}
