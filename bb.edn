;; Babashka config for the DEV TOOLING only (scripts/dev_repl.clj). ClojureWasm
;; itself is a Zig project — nothing in src/ or the gate depends on this file or
;; on bb being installed.
;;
;; `scripts` is on the path so `scripts/dev/*.cljc` resolves the same way under
;; bb as it does under cljw (`cljw -cp scripts`), which is what lets the nREPL
;; client be ONE implementation shared by both runtimes.
{:paths ["scripts"]}
